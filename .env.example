# ===========================================
# TG-BOT Configuration
# ===========================================

# Profile Configuration
# ---------------------
# Name of the profile file (without .json extension)
# The bot will look for {PROFILE_NAME}.json and {PROFILE_NAME}.session
PROFILE_NAME=profile

# Base directory for profile files (defaults to current directory)
BASE_DIR=.

# Proxy Configuration
# -------------------
# All fields required if using proxy
# Supported types: SOCKS5, SOCKS4, HTTP
PROXY_TYPE=
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Captcha Configuration
# ---------------------
# 2Captcha API Key (for image captcha solving)
# Get your key from https://2captcha.com
CAPTCHA_API_KEY=

# Logging Configuration
# ---------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: simple, detailed, json
#   simple   - "LEVEL    | message"
#   detailed - "timestamp | LEVEL    | module:func:line | message"
#   json     - {"time": "...", "level": "...", "module": "...", "message": "..."}
LOG_FORMAT=simple

# Worker Configuration
# --------------------
# Redis connection URL
REDIS_URL=redis://localhost:6379

# Seconds to keep task results in Redis
RESULT_TTL=300

# Grafana Cloud Monitoring (Optional)
# ------------------------------------
# Install monitoring dependencies: pip install tg-bot[monitoring]
#
# Environment name (used as label in metrics/logs)
ENVIRONMENT=development

# Grafana Cloud credentials (from grafana.com -> My Account -> API Keys)
GRAFANA_CLOUD_USER=
GRAFANA_CLOUD_API_KEY=

# Prometheus push gateway URL for metrics
# Format: https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
PROMETHEUS_PUSH_GATEWAY=

# Loki URL for log shipping
# Format: https://logs-prod-XX.grafana.net/loki/api/v1/push
LOKI_URL=
